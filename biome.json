{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "spike/**/*.ts",
      "*.json",
      "vitest.config.ts",
      "!.claude",
      "!.gemini",
      "!.github",
      "!.grugops",
      "!coverage",
      "!memory-bank",
      "!plans"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
