[
 "<cutechess-cli>",
 "-engine",
 "name=skytalix",
 "cmd=<node>",
 "arg=<scratch>/out/base/clone-skytalix/dist/uci.js",
 "dir=<scratch>/out/base/clone-skytalix",
 "st=4",
 "timemargin=1000",
 "restart=on",
 "option.Skill Level=6",
 "stderr=<scratch>/run-B/skytalix.stderr",
 "-engine",
 "name=stockfish",
 "cmd=<stockfish>",
 "st=0.5",
 "timemargin=2000",
 "restart=on",
 "option.Threads=1",
 "option.Hash=16",
 "option.UCI_LimitStrength=true",
 "option.UCI_Elo=1910",
 "stderr=<scratch>/run-B/stockfish.stderr",
 "-each",
 "proto=uci",
 "-openings",
 "file=<worktree>/tools/rating/openings.epd",
 "format=epd",
 "order=sequential",
 "start=1",
 "-repeat",
 "-games",
 "2",
 "-rounds",
 "1",
 "-concurrency",
 "1",
 "-maxmoves",
 "200",
 "-pgnout",
 "<scratch>/run-B/r.pgn",
 "-debug",
 "all"
]