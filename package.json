{
  "name": "cli-chess",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Command-line chess against a club-strength engine.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node tools/grugops/run-bounded.js 60000 vitest run --reporter=default --reporter=json --outputFile.json=.test-results/last-run.json",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write",
    "build": "tsc --noEmit",
    "chess": "node src/cli.ts",
    "perft": "node src/perft-bench.ts",
    "spike:perft": "node spike/perft-bench.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
