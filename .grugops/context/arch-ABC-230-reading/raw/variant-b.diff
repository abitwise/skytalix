+/** PROBE ONLY (Q3 option (b)): a pawn of the side to move stands beside the double-pushed pawn. */
+function epCapturerBeside(position: Position): boolean {
+  const target = position.epSquare;
+  const pushed = target + (position.blackToMove ? 16 : -16);
+  for (const side of [pushed - 1, pushed + 1]) {
+    if (!isOnBoard(side)) continue;
+    const piece = position.board[side] as number;
+    if (piece !== EMPTY && (piece & 7) === 1 && isBlack(piece) === position.blackToMove) return true;
+  }
+  return false;
+}
+
 /** The square the en-passant-captured pawn stood on: one rank behind the target, same file. */
 const enPassantCaptureSquare = (move: Move): number => move.to + (isBlack(move.piece) ? 16 : -16);
 
